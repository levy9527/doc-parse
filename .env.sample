# doc-parse 配置样板
# 用法：复制为 .env 后按需修改（或直接把同名变量作为容器/进程环境变量注入）。
# 全部可选；不设置时用「默认」列的值。

# ─────────────────────────────────────────────────────────────
# OCR 模式
# ─────────────────────────────────────────────────────────────
# auto   默认：只对「缺文字页」做 OCR（推荐）
# always 每页都强制 OCR（忽略文字层；慢，用于排查/质检）
# never  完全不 OCR（缺文字页输出占位提示）
OCR_MODE=auto

# 页原生文字少于该值 → 判为「缺文字页」→ OCR
PDF_TEXT_MIN_CHARS=300

# 渲染分辨率（pypdfium2 光栅化）。越高越清晰但越慢；200 为实测默认
OCR_DPI=200

# 无文字层页是否做表格结构重建（慢；需要表格结构时开）
TABLE_ENABLED=false

# ONNX 模型根目录；留空 = 用各包默认（镜像内已预置于 /app/models 与 site-packages）
# OCR_MODEL_DIR=

# ─────────────────────────────────────────────────────────────
# onnxruntime 线程数（重要：只影响速度，不影响解析结果）
# ─────────────────────────────────────────────────────────────
# 为什么需要手动设？onnxruntime 的「自动」会按可见核数把线程池开满，在容器里
# 属于超额订阅（线程互相抢核 + 上下文切换），实测反而最慢：
#   Mac 12 核    : auto 0.936s/页 → 8 线程 0.528s → 6  线程 0.468s（最快）
#   服务器 96 核 : auto 1.676s/页 → 8 线程 1.065s → 16 线程 0.766s（最快）
# 经验法则：取「可见核数」的 1/2 ~ 1/6，再按机器实测微调（太多、太少都变慢）。
#
# ⚠️ 注意：OMP_NUM_THREADS 对本环境的 onnxruntime 无效（它用自己的线程池，
#    不走 OpenMP），必须用下面的 OCR_INTRA_THREADS。
OCR_INTRA_THREADS=8

# onnxruntime inter-op 线程数；一般保持 0（自动）即可
OCR_INTER_THREADS=0

# ─────────────────────────────────────────────────────────────
# 页级并行（多进程按页并行；1 = 串行）
# ─────────────────────────────────────────────────────────────
# 收益取决于「单页是否已吃满核」：并行度 ≈ 可见核数 ÷ 单页线程数。
#   Mac 12 核   : 单页 OCR 已吃满 12 核（CPU≈1300%）→ 并行几无收益，建议 1
#   服务器 96 核: 单页只用 ~16 线程 → 大量核空闲，建议 2~4
# 约束：PDF_WORKERS × OCR_INTRA_THREADS 最好 ≤ 可见核数（否则又超额订阅）；
#      每个进程各加载一套 ONNX 模型，内存约为单进程的 N 倍。
PDF_WORKERS=2
